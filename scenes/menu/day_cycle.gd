class_name DayCycle
extends RefCounted
## Цикл суток пейзажа меню: фаза 0..1 (0 — полночь, 0.25 — восход, 0.5 — полдень, 0.75 — закат).
## state(p) — всё, что нужно сцене на эту фазу: цвета неба, направление и цвет света, доля горящих окон,
## плотность машин, яркость ночных огней, экспозиция. Ключевые кадры — KEYS, между ними — плавная интерполяция.

## Длительность полного цикла, с (просьба: «за 2–3 минуты день и ночь менялись»).
const CYCLE_SEC := 150.0
## С какой фазы начинается меню: ближе к вечеру — закат и огни видны в первые полминуты.
const START_PHASE := 0.66

## Ключевые кадры: фаза, зенит, горизонт, свечение у солнца, цвет солнечного света, сила солнца,
## доля окон, ночь (яркость огней 0..1), машины (плотность), экспозиция, облачность.
const KEYS := [
	[0.00, Color(0.010, 0.016, 0.042), Color(0.045, 0.060, 0.115), Color(0.06, 0.06, 0.10), Color(1.0, 0.8, 0.6), 0.0, 0.34, 1.0, 0.30, 1.10, 0.42],
	[0.17, Color(0.012, 0.020, 0.055), Color(0.055, 0.065, 0.125), Color(0.10, 0.08, 0.14), Color(1.0, 0.7, 0.5), 0.0, 0.22, 1.0, 0.18, 1.10, 0.40],
	[0.225, Color(0.07, 0.10, 0.24), Color(0.42, 0.30, 0.36), Color(0.95, 0.45, 0.25), Color(1.0, 0.55, 0.35), 0.0, 0.22, 0.85, 0.30, 1.20, 0.42],
	[0.265, Color(0.20, 0.34, 0.62), Color(0.92, 0.66, 0.52), Color(1.0, 0.60, 0.32), Color(1.0, 0.68, 0.42), 1.5, 0.10, 0.35, 0.60, 1.00, 0.45],
	[0.33, Color(0.20, 0.42, 0.82), Color(0.66, 0.77, 0.90), Color(1.0, 0.88, 0.72), Color(1.0, 0.90, 0.78), 2.6, 0.03, 0.0, 0.95, 0.90, 0.48],
	[0.50, Color(0.16, 0.38, 0.82), Color(0.62, 0.76, 0.93), Color(1.0, 0.95, 0.85), Color(1.0, 0.97, 0.92), 3.0, 0.02, 0.0, 0.70, 0.88, 0.52],
	[0.66, Color(0.19, 0.40, 0.80), Color(0.72, 0.78, 0.88), Color(1.0, 0.85, 0.65), Color(1.0, 0.90, 0.74), 2.6, 0.05, 0.0, 0.85, 0.90, 0.50],
	[0.715, Color(0.20, 0.32, 0.62), Color(1.0, 0.70, 0.46), Color(1.0, 0.55, 0.22), Color(1.0, 0.64, 0.34), 2.1, 0.14, 0.15, 1.00, 0.95, 0.50],
	[0.752, Color(0.13, 0.16, 0.38), Color(0.98, 0.44, 0.24), Color(1.0, 0.36, 0.12), Color(1.0, 0.46, 0.22), 1.2, 0.32, 0.50, 1.00, 1.05, 0.48],
	[0.785, Color(0.045, 0.065, 0.19), Color(0.36, 0.22, 0.34), Color(0.65, 0.24, 0.24), Color(1.0, 0.4, 0.3), 0.0, 0.42, 0.90, 0.90, 1.10, 0.46],
	[0.84, Color(0.012, 0.020, 0.052), Color(0.055, 0.068, 0.13), Color(0.08, 0.07, 0.12), Color(1.0, 0.8, 0.6), 0.0, 0.48, 1.0, 0.65, 1.10, 0.44],
	[1.00, Color(0.010, 0.016, 0.042), Color(0.045, 0.060, 0.115), Color(0.06, 0.06, 0.10), Color(1.0, 0.8, 0.6), 0.0, 0.34, 1.0, 0.30, 1.10, 0.42],
]

const MOON_COLOR := Color(0.62, 0.72, 1.0)
const MOON_ENERGY := 0.28


## Направление НА солнце: восходит слева-сзади (днём фасады к камере освещены), в полдень высоко,
## садится справа-спереди — закат за городом (камера смотрит в −Z).
static func sun_dir(p: float) -> Vector3:
	var th := TAU * (p - 0.25)
	return Vector3(-cos(th), sin(th) * 0.82, 0.6 * cos(th) + 0.15).normalized()


## Луна — напротив солнца по дуге, тоже впереди камеры.
static func moon_dir(p: float) -> Vector3:
	var th := TAU * (p - 0.25)
	return Vector3(cos(th) * 0.9, -sin(th) * 0.7, -0.75).normalized()


## Часы для подписи в углу: «18:40».
static func clock_text(p: float) -> String:
	var m := int(fposmod(p, 1.0) * 24.0 * 60.0)
	return "%02d:%02d" % [m / 60, m % 60]


static func state(p: float) -> Dictionary:
	p = fposmod(p, 1.0)
	var i := 0
	while i < KEYS.size() - 2 and p >= float(KEYS[i + 1][0]):
		i += 1
	var a: Array = KEYS[i]
	var b: Array = KEYS[i + 1]
	var k := clampf((p - float(a[0])) / maxf(float(b[0]) - float(a[0]), 0.0001), 0.0, 1.0)
	k = k * k * (3.0 - 2.0 * k)
	var s := {}
	s.zenith = (a[1] as Color).lerp(b[1], k)
	s.horizon = (a[2] as Color).lerp(b[2], k)
	s.glow = (a[3] as Color).lerp(b[3], k)
	s.sun_color = (a[4] as Color).lerp(b[4], k)
	s.windows = lerpf(a[6], b[6], k)
	s.night = lerpf(a[7], b[7], k)
	s.traffic = lerpf(a[8], b[8], k)
	s.exposure = lerpf(a[9], b[9], k)
	s.cover = lerpf(a[10], b[10], k)
	var sd := sun_dir(p)
	var md := moon_dir(p)
	s.sun_dir = sd
	s.moon_dir = md
	# Источник света: солнце над горизонтом, иначе луна; у горизонта сила уходит в ноль — без скачка направления.
	var sun_e: float = lerpf(a[5], b[5], k) * smoothstep(0.0, 0.10, sd.y)
	var moon_e: float = MOON_ENERGY * smoothstep(0.0, 0.15, md.y)
	if sd.y > 0.0:
		s.light_dir = sd
		s.light_color = s.sun_color
		s.light_energy = maxf(sun_e, 0.0)
	else:
		s.light_dir = md
		s.light_color = MOON_COLOR
		s.light_energy = moon_e
	s.day = smoothstep(-0.05, 0.25, sd.y)
	return s
